{
  "ServerSettings": {
    "PrivateMode": true,
    "ProhibitGroups": false,
    "ProhibitGeneral": true,
    "UserGroupLimit": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:9090"
      },
      "Https": {
        "Url": "https://*:9443"
      }
    }
  }
}